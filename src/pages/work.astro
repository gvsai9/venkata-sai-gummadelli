---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Work — Venkata Sai Gummadelli"
    description="Projects, experiments, and work by Venkata Sai Gummadelli."
>

    <section class="work-page">

        <div class="section-label">
            <span>WORK</span>
            <span>PROJECTS & EXPERIMENTS</span>
        </div>

        <div class="work-intro">

            <h1>
                Things I<br />
                <em>build.</em>
            </h1>

            <p>
                A collection of projects, experiments, and systems
                I have built while exploring ideas in technology.
            </p>

        </div>


        <div class="work-list">

            <article class="work-item" id="agentic-ai-research">

                <div class="work-number">
                    01
                </div>

                <div class="work-content">

                    <div class="work-meta">
                        <span>AI</span>
                        <span>RESEARCH</span>
                    </div>

                    <h2>
                        Agentic AI Research
                    </h2>

                    <p>
                        Exploring architectures and evaluation methods
                        for intelligent agents, with a focus on building
                        systems that can reason, use tools, and make
                        decisions reliably.
                    </p>

                    <span class="work-status">
                        Ongoing
                    </span>

                </div>

            </article>


            <article class="work-item" id="langchain-vs-langgraph">

                <div class="work-number">
                    02
                </div>

                <div class="work-content">

                    <div class="work-meta">
                        <span>AI SYSTEMS</span>
                        <span>EXPERIMENT</span>
                    </div>

                    <h2>
                        LangChain vs LangGraph
                    </h2>

                    <p>
                        A structured exploration of agent architectures,
                        comparing different approaches to building
                        multi-step AI systems through controlled
                        experiments and evaluation.
                    </p>

                    <span class="work-status">
                        Experiment
                    </span>

                </div>

            </article>


            <article class="work-item" id="model-context-protocol">

                <div class="work-number">
                    03
                </div>

                <div class="work-content">

                    <div class="work-meta">
                        <span>AI</span>
                        <span>INFRASTRUCTURE</span>
                    </div>

                    <h2>
                        Model Context Protocol
                    </h2>

                    <p>
                        Exploring how standardized tool and context
                        interfaces can change the way AI agents interact
                        with external systems.
                    </p>

                    <span class="work-status">
                        Exploring
                    </span>

                </div>

            </article>

        </div>


        <div class="work-note">

            <p>
                More projects will appear here as the work evolves.
            </p>

        </div>

    </section>

</BaseLayout>