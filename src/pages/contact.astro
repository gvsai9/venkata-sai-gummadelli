---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Contact — Venkata Sai Gummadelli"
    description="Get in touch with Venkata Sai Gummadelli."
>

    <section class="contact-page">

        <div class="section-label">
            <span>CONTACT</span>
            <span>LET'S CONNECT</span>
        </div>

        <div class="contact-intro">

            <h1>
                Have an idea?<br />
                <em>Let's talk.</em>
            </h1>

            <p>
                Whether you want to discuss technology, AI,
                research, ideas, or simply say hello, feel free
                to reach out.
            </p>

        </div>

        <div class="contact-links">

            <a
                href="mailto:gummadellivenkatsai@gmail.com"
                class="contact-link"
            >
                <span>Email</span>
                <span>↗</span>
            </a>

            <a
                href="https://www.linkedin.com/in/venkata-sai-gummadelli/"
                class="contact-link"
                target="_blank"
                rel="noopener noreferrer"
            >
                <span>LinkedIn</span>
                <span>↗</span>
            </a>

            <a
                href="https://medium.com/@gummadellivenkatsai"
                class="contact-link"
                target="_blank"
                rel="noopener noreferrer"
            >
                <span>Medium</span>
                <span>↗</span>
            </a>

        </div>

    </section>

</BaseLayout>